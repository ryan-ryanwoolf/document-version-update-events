# Copy to your ECS task definition / CI secrets. Do not commit real values.

SPRING_PROFILES_ACTIVE=aws
AWS_REGION=eu-west-1
SERVER_PORT=3030

# RDS (same VPC as ECS tasks; security group must allow 5432 from task SG)
DB_HOST=your-db.xxxxx.eu-west-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_SCHEMA=lexis-nexis-events
# Extra JDBC query params appended after currentSchema (default in application-aws.properties: &sslmode=require)
# DB_JDBC_PARAMS=

# Existing SQS standard queue (not FIFO)
AWS_SQS_REVISION_EVENTS_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/123456789012/document-revision-events

# Demo HTTP off in production
APP_DEMO_ENDPOINTS_ENABLED=false
APP_DEMO_RETRY_VERIFICATION_ENABLED=false
